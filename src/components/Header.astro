---
import { SITE } from '../site';
const links = [
  { href: '/projetos', label: 'Projetos' },
  { href: '/sobre', label: 'Sobre' },
  { href: SITE.curriculo, label: 'Currículo' },
];
const atual = Astro.url.pathname;
---
<header class="sticky top-0 z-10 border-b border-zinc-200/70 bg-white/80 backdrop-blur dark:border-zinc-800/70 dark:bg-zinc-950/80">
  <nav class="mx-auto flex max-w-4xl items-center justify-between px-4 py-3 sm:px-6">
    <a href="/" class="font-semibold tracking-tight">Saulo<span class="text-accent">.</span></a>
    <div class="flex items-center gap-5 text-sm">
      {links.map((l) => (
        <a href={l.href} class:list={['hover:text-accent transition-colors', atual.startsWith(l.href) && 'text-accent']}>{l.label}</a>
      ))}
      <button id="tema" aria-label="Alternar tema" class="rounded-md p-1.5 hover:bg-zinc-100 dark:hover:bg-zinc-800">
        <svg class="size-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="hidden size-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
    </div>
  </nav>
</header>
<script>
  document.getElementById('tema')?.addEventListener('click', () => {
    const escuro = document.documentElement.classList.toggle('dark');
    localStorage.setItem('tema', escuro ? 'dark' : 'light');
  });
</script>
