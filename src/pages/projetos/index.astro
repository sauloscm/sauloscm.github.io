---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { listarProjetos } from '../../projetos';

const projetos = await listarProjetos();
---
<Base titulo="Projetos">
  <h1 class="mb-2 text-3xl font-bold">Projetos</h1>
  <p class="mb-10 text-zinc-600 dark:text-zinc-400">
    Boa parte do código é privada (empresa e projetos de extensão). Por isso, cada projeto é contado como estudo de caso: problema, solução, arquitetura e resultado.
  </p>
  <div class="grid gap-6 sm:grid-cols-2">
    {projetos.map((p) => <ProjectCard projeto={p} />)}
  </div>
</Base>
